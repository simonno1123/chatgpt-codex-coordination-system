{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acos.example/schemas/w3b-b-p1/1.0/disposable-fixture-research-binding.schema.json",
  "title": "ACOS W3B-B-P1 Disposable Fixture Research Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version", "contract_version", "object_type", "binding_id",
    "binding_digest", "task_id", "user_decision_reference",
    "chatgpt_task_evidence", "chatgpt_task_digest", "fixture_instance_id",
    "fixture_factory_version",
    "canonical_seed_digest", "pre_mutation_fixture_digest",
    "fault_profile", "fault_profile_digest", "snapshot_reference",
    "repair_evidence", "repair_plan", "plan_verification", "plan_id",
    "plan_digest", "evidence_set_digest", "allowed_action",
    "expected_postconditions", "expected_postconditions_digest",
    "maximum_mutation_count",
    "issued_at", "expires_at", "operation_id", "nonce", "executor_claim",
    "authorization_source_claim", "scope", "evidence_class",
    "governance_status", "effects", "eligible_for_execution",
    "fixture_mutation_scope", "production_repair_effect",
    "production_eligibility", "operational_entry_effect"
  ],
  "properties": {
    "profile_version": {"const": "1.0"},
    "contract_version": {"const": "2.0"},
    "object_type": {"const": "disposable_fixture_research_binding"},
    "binding_id": {"type": "string", "minLength": 1},
    "binding_digest": {"$ref": "#/definitions/digest"},
    "task_id": {"const": "ACOS-MIG-W3B-B-P1-IMPLEMENTATION-02"},
    "user_decision_reference": {"type": "string", "minLength": 1},
    "chatgpt_task_evidence": {"type": "object"},
    "chatgpt_task_digest": {"$ref": "#/definitions/digest"},
    "fixture_instance_id": {"type": "string", "minLength": 1},
    "fixture_factory_version": {"const": "w3b-b-p1/1.0"},
    "canonical_seed_digest": {"$ref": "#/definitions/digest"},
    "pre_mutation_fixture_digest": {"$ref": "#/definitions/digest"},
    "fault_profile": {"type": "object"},
    "fault_profile_digest": {"$ref": "#/definitions/digest"},
    "snapshot_reference": {"type": "object"},
    "repair_evidence": {"type": "object"},
    "repair_plan": {"type": "object"},
    "plan_verification": {"type": "object"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_digest": {"$ref": "#/definitions/digest"},
    "evidence_set_digest": {"$ref": "#/definitions/digest"},
    "allowed_action": {"const": "RECREATE_MISSING_CANONICAL_INDEX"},
    "expected_postconditions": {"type": "object"},
    "expected_postconditions_digest": {"$ref": "#/definitions/digest"},
    "maximum_mutation_count": {"const": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "operation_id": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 1},
    "executor_claim": {"type": "string", "minLength": 1},
    "authorization_source_claim": {"type": "string", "minLength": 1},
    "scope": {"const": "DISPOSABLE_FIXTURE_ONLY"},
    "evidence_class": {"const": "DECLARED_BINDING_EVIDENCE"},
    "governance_status": {"const": "UNAUTHENTICATED_SHADOW"},
    "effects": {"const": "NONE"},
    "eligible_for_execution": {"const": false},
    "fixture_mutation_scope": {"const": "TEST_ONLY_DISPOSABLE_FIXTURE"},
    "production_repair_effect": {"const": "NONE"},
    "production_eligibility": {"const": false},
    "operational_entry_effect": {"const": "NONE"}
  },
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
