{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:acos:schema:w3:grant-observation:1.0",
  "title": "ACOS W3A Grant Observation Shadow Schema 1.0",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{1,511}$"},
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version"],
      "properties": {"contract_version": {"const": "2.0"}}
    }
  },
  "required": [
    "profile_version", "contract_binding", "observation_id", "grant_id",
    "claimed_governance_state", "observer_state", "source_reference",
    "observed_at", "claim_status", "governance_status", "authority_effect",
    "identity_effect", "execution_effect", "activation_effect",
    "eligible_for_execution"
  ],
  "properties": {
    "profile_version": {"const": "1.0"},
    "contract_binding": {"$ref": "#/definitions/contractBinding"},
    "observation_id": {"$ref": "#/definitions/reference"},
    "grant_id": {"$ref": "#/definitions/reference"},
    "claimed_governance_state": {
      "type": "string",
      "enum": [
        "DEFINED", "ISSUED", "VALIDATED", "ACTIVE", "CONSUMED",
        "DENIED", "REVOKED", "EXPIRED", "SUPERSEDED", "FAILED"
      ]
    },
    "observer_state": {"const": "OBSERVED"},
    "source_reference": {"$ref": "#/definitions/reference"},
    "observed_at": {"type": "string", "format": "date-time"},
    "claim_status": {"const": "DECLARED_ONLY"},
    "governance_status": {"const": "UNAUTHENTICATED_SHADOW"},
    "authority_effect": {"const": "NONE"},
    "identity_effect": {"const": "NONE"},
    "execution_effect": {"const": "NONE"},
    "activation_effect": {"const": "NONE"},
    "eligible_for_execution": {"const": false}
  }
}
